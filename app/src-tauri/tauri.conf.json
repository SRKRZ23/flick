{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "version": "0.2.0",
  "identifier": "uz.sardor.flick",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flick",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 540,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "copyright": "© 2026 Sardor Razikov. MIT licensed.",
    "shortDescription": "Local, open-source file converter.",
    "longDescription": "Drag a file, hold a key, drop it on a format. Flick converts images, video, audio, PDF, documents and archives entirely on your Mac — nothing is ever uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
